#include <stdio.h>
#include <stdlib.h>

void writeFile() {
    FILE *fp;
    char filename[50], data[1000];

    printf("Enter file name: ");
    scanf("%s", filename);

    fp = fopen(filename, "w");
    if (fp == NULL) {
        printf("Error: Cannot create file!\n");
        return;
    }

    printf("Enter text (end with ~):\n");
    scanf(" %[^\~]", data);

    fprintf(fp, "%s", data);
    fclose(fp);

    printf("File written successfully.\n");
}

void readFile() {
    FILE *fp;
    char filename[50], ch;

    printf("Enter file name: ");
    scanf("%s", filename);

    fp = fopen(filename, "r");
    if (fp == NULL) {
        printf("Error: File does not exist!\n");
        return;
    }

